model Task {
  id             String        @id @default(uuid())
  title          String
  description    String?
  status         TaskStatus    @default(pending)
  priority       TaskPriority
  priorityOrder  Int
  dueDate        DateTime?
  completionDate DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  notification   Notification[]
}

model Notification {
  id        String           @id @default(uuid())
  message   String
  type      NotificationType @default(default)
  dueDate   DateTime
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  task      Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

model Group {
  id          String             @id @default(uuid())
  name        String
  createdAt   DateTime           @default(now())
  members     GroupMembership[]
  meetings    Meeting[]          
}

model GroupMembership {
  id        String     @id @default(uuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  role      GroupRole  @default(member)
  joinedAt  DateTime   @default(now())

  @@unique([userId, groupId])
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  name               String
  password           String?
  telegramChatId     String?

  googleId           String?            @unique
  provider           String             @default("local")

  calendarConnected  Boolean            @default(false)
  googleAccessToken  String?
  googleRefreshToken String?
  accessTokenExpiry  DateTime?
  
  // Calendar sync settings
  lastCalendarSync    DateTime?
  timeZone           String             @default("UTC")

  tasks              Task[]
  notification       Notification[]
  groupMemberships   GroupMembership[]
  calendarEvents     CalendarEvent[]    // Add this
  meetings           Meeting[]          // Add this
  meetingAttendees   MeetingAttendee[]  // Add this

  calendarChannels CalendarChannel[]

  calendarLinks   CalendarShareLink[]
}


model CalendarEvent {
  id           String    @id @default(uuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  
  title        String
  description  String?
  startTime    DateTime
  endTime      DateTime
  isAllDay     Boolean   @default(false)
  
  googleEventId String?  @unique
  
  status       EventStatus @default(confirmed)
  
  isRecurring  Boolean   @default(false)
  recurringRule String?  // RRULE format
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  @@index([userId, startTime, endTime])
}

model Meeting {
  id           String    @id @default(uuid())
  title        String
  description  String?
  
  startTime    DateTime
  endTime      DateTime
  duration     Int       // in minutes
  
  // Group association
  group        Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId      String
  
  // Meeting organizer
  organizer    User      @relation(fields: [organizerId], references: [id])
  organizerId  String
  
  // Meeting location/link
  location     String?
  meetingLink  String?
  
  // Meeting status
  status       MeetingStatus @default(confirmed)
  
  // Google Calendar integration
  googleEventId String?
  
  attendees    MeetingAttendee[]
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  @@index([groupId, startTime])
}

model MeetingAttendee {
  id         String    @id @default(uuid())
  meeting    Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingId  String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  
  status     AttendeeStatus @default(pending)
  response   String?   // Optional response message
  
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  
  @@unique([meetingId, userId])
}
model CalendarChannel {
  id            String   @id @default(uuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  channelId     String   // the channel ID you generate
  resourceId    String   // from Google response
  expiration    DateTime // expires at
  token         String?  // optional, for added security
  createdAt     DateTime @default(now())
}


model CalendarShareLink {
  id                String   @id @default(uuid())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String

  token             String   @unique
  expiresAt         DateTime

  // Booking Window
  availableStart    DateTime // Start of booking window (e.g. now)
  availableEnd      DateTime // End of booking window (e.g. now + 7 days)

  // Time Preferences
  slotDuration      Int      // Duration in minutes (e.g. 30)
  bufferBetween     Int?     // Buffer in minutes between meetings (e.g. 15)
  earliestHour      Int      // e.g. 9 (9am)
  latestHour        Int      // e.g. 17 (5pm)
  timezone          String   // e.g. "Asia/Kolkata" — helps render in UI + schedule precisely
  allowWeekends     Boolean  @default(false) // Only show Mon–Fri if false

  // Control flags
  allowBookingEdit  Boolean  @default(true) // If bookings from link can be edited/rescheduled
  isActive          Boolean  @default(true)

  createdAt         DateTime @default(now())
}



// ENUMS
enum EventStatus {
  confirmed
  tentative
  cancelled
}

enum MeetingStatus {
  confirmed    // Default for scheduled events (matches Google "confirmed")
  tentative    // For events marked as tentative (matches Google "tentative")
  cancelled    // For cancelled or deleted events (matches Google "cancelled")
}


enum AttendeeStatus {
  pending
  accepted
  declined
  tentative
}
