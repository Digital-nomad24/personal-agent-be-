generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum TaskStatus {
  pending
  completed
}

enum TaskPriority {
  high
  medium
  low
}

enum NotificationType {
  default
  critical
}

enum GroupRole {
  member
  admin
}


